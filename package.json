{
  "name": "kalarm-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "pnpm run check:entry && expo start --dev-client",
    "android": "pnpm run check:entry && expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android": "eas build --platform android --profile development",
    "assets:check": "node scripts/verify-softcare-icons.cjs",
    "check:entry": "node scripts/check-entry.cjs",
    "start:clear": "pnpm run check:entry && expo start --dev-client --clear",
    "start:go": "pnpm run check:entry && node scripts/run-go.cjs",
    "start:go:clear": "pnpm run check:entry && node scripts/run-go.cjs --clear",
    "start:dev": "pnpm run check:entry && expo start --dev-client",
    "start:go:safe": "pnpm run check:entry && node scripts/run-go.cjs --clear",
    "start:smoke": "pnpm run check:entry && node scripts/run-go.cjs --smoke --clear",
    "test:go-mode": "node --test scripts/go-mode.test.cjs",
    "start:android:go:safe": "pnpm run check:entry && node scripts/run-go.cjs --android --clear",
    "start:android:dev": "pnpm run check:entry && expo start --dev-client --android --clear",
    "test:layout": "node --test scripts/project-layout.test.cjs",
    "check:project": "pnpm run check:entry && pnpm run test:layout && pnpm run assets:check && pnpm run check"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-router": "~57.0.29",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-notifications": "~57.0.24",
    "expo-dev-client": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "expo-sqlite": "~57.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "expo-doctor": "*",
    "eas-cli": "*"
  },
  "packageManager": "pnpm@10.34.7"
}
