{
  "name": "kalarm-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "pnpm run check:entry && expo start --go",
    "android": "pnpm run check:entry && expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android": "eas build --platform android --profile development",
    "assets:check": "node scripts/verify-softcare-icons.cjs",
    "check:entry": "node scripts/check-entry.cjs",
    "start:clear": "pnpm run check:entry && expo start --go --clear",
    "start:go": "pnpm run check:entry && expo start --go",
    "start:go:clear": "pnpm run check:entry && expo start --go --clear",
    "start:dev": "pnpm run check:entry && expo start --dev-client",
    "start:go:safe": "pnpm run check:entry && node scripts/run-go.cjs --clear",
    "start:smoke": "pnpm run check:entry && node scripts/run-go.cjs --smoke --clear",
    "test:go-mode": "node --test scripts/go-mode.test.cjs",
    "start:android:go:safe": "pnpm run check:entry && node scripts/run-go.cjs --android --clear",
    "start:android:dev": "pnpm run check:entry && expo start --dev-client --android --clear",
    "test:layout": "node --test scripts/project-layout.test.cjs",
    "check:project": "pnpm run check:entry && pnpm run check:sdk && pnpm run test:layout && pnpm run assets:check && pnpm run check",
    "start:android:go": "pnpm run check:entry && expo start --go --android --clear",
    "check:sdk": "node scripts/check-sdk58.cjs"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-router": "~58.0.20",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "expo-notifications": "~58.1.6",
    "expo-dev-client": "~58.0.15",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "expo-sqlite": "~58.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "expo-doctor": "*",
    "eas-cli": "*"
  },
  "packageManager": "pnpm@10.34.7"
}
